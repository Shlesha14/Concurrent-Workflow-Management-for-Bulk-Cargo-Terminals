<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>edu.geu.portflow</groupId>
  <artifactId>portflow</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>PortFlow</name>
  <description>Concurrent Workflow Management for Bulk Cargo Terminals (OS + DBMS project)</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
    <mysql.connector.version>8.4.0</mysql.connector.version>
    <!-- Test database (must be a scratch schema: tests DROP and recreate its tables). Override with -Dportflow.test.url=... -->
    <portflow.test.url>jdbc:mysql://localhost:3306/portflow_test?useSSL=false&amp;allowPublicKeyRetrieval=true</portflow.test.url>
    <portflow.test.user>root</portflow.test.user>
    <portflow.test.password></portflow.test.password>
  </properties>

  <dependencies>
    <!-- JDBC driver for MySQL 8.x. This is the only runtime dependency. -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>${mysql.connector.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- database/*.sql is the single source of truth; it is also packaged on the classpath under sql/ -->
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>database</directory><targetPath>sql</targetPath></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!-- DB tests read these; override with -Dportflow.test.url=... -->
          <systemPropertyVariables>
            <portflow.test.url>${portflow.test.url}</portflow.test.url>
            <portflow.test.user>${portflow.test.user}</portflow.test.user>
            <portflow.test.password>${portflow.test.password}</portflow.test.password>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.portflow.ui.PortFlowApp</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <createDependencyReducedPom>false</createDependencyReducedPom>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
